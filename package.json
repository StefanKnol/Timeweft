{
  "name": "timeweft",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "node --test --experimental-strip-types \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-no-canon": "node scripts/check-no-canon.mjs",
    "export-run": "pnpm --silent --filter @timeweft/server export-run",
    "export-all": "pnpm --silent --filter @timeweft/server export-all",
    "restore-run": "pnpm --silent --filter @timeweft/server restore-run",
    "seed-demo-run": "pnpm --silent --filter @timeweft/server seed-demo-run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
